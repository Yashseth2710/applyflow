# Copy to .env.local
# NEXT_PUBLIC_* values are embedded in the browser bundle.
# Never put secrets here.

# Locally the API is a separate process on another port, so this is absolute.
# Deployed, the API is a second service behind the same domain and this becomes
# the relative "/api/v1" — which is set in the hosting environment, not here.
# Same origin also means no CORS and a refresh cookie that keeps working.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
