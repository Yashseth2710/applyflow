# ApplyFlow backend — environment template
# Copy this file to `.env` and fill in real values.
# `.env` is gitignored and must NEVER be committed.

# ---- Database ----
# Neon connection string. Requirements:
#   - starts with postgresql://
#   - real password (not masked dots)
#   - ends with ?sslmode=require
#   - NO "-pooler" in the hostname (disable connection pooling in the Neon UI)
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# ---- Auth ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- App ----
ENVIRONMENT=development
DEBUG=true
# Logs every SQL statement. Useful when debugging queries, very noisy otherwise.
SQL_ECHO=false
API_V1_PREFIX=/api/v1

# ---- CORS ----
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# ---- Rate limiting ----
RATE_LIMIT_ENABLED=true
# How many proxies sit in front of the app.
#   0  requests arrive directly, so the socket address is the caller
#   1  something terminates TLS in front of you (Render, a load balancer)
# Not cosmetic. Too low and every caller counts as one address, so the first
# attacker locks everyone else out. Too high and the limit keys on a header the
# caller wrote themselves, which they can change on every request. In
# production the app refuses to start unless this is set on purpose.
RATE_LIMIT_PROXY_DEPTH=0

# Failed sign-ins are also counted against the email address, in the database,
# so a guessing run spread across many source addresses still runs out — and so
# the count is not forgotten when the process restarts.
LOGIN_ATTEMPT_LIMIT=10
LOGIN_ATTEMPT_WINDOW_MINUTES=15
# Per address, per day. Also durable: an account created during a burst does
# not disappear when the host restarts, so neither should the record of it.
REGISTER_DAILY_LIMIT=10
# Per account, per day, on the endpoint that spends real money.
AI_DAILY_LIMIT=60
UPLOAD_HOURLY_LIMIT=30

# Rows are the other way to fill a database with a hard size ceiling. The
# upload quota bounds bytes arriving as files and does nothing about these.
MAX_APPLICATIONS_PER_USER=1000
MAX_INTERVIEWS_PER_APPLICATION=50

# ---- Timezone ----
# Fallback when a user's timezone cannot be detected
DEFAULT_TIMEZONE=Asia/Kolkata

# ---- File uploads ----
MAX_UPLOAD_SIZE_MB=5
# Total per account, versions included. The per-file cap above bounds one
# upload; this bounds all of them. Without it the same five megabytes sent two
# hundred times fills the free 500 MB database without breaking a single rule.
MAX_STORAGE_PER_USER_MB=50
ALLOWED_UPLOAD_TYPES=application/pdf
# postgres | local
# postgres keeps uploads in the database, which is the only option that survives
# a redeploy on a host with an ephemeral filesystem. local writes to UPLOAD_DIR
# and is there for looking at files by hand during development.
STORAGE_BACKEND=postgres
UPLOAD_DIR=./uploads

# ---- AI provider ----
# mock | ollama | gemini
#   mock    canned answers, no network — what tests and CI use
#   ollama  a model on this machine; free and private, but needs several GB of
#           RAM so it cannot run on a small host
#   gemini  free tier, and the only option that works once deployed
AI_PROVIDER=mock

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Free key from https://aistudio.google.com/apikey — no card needed.
GEMINI_API_KEY=
# Preview models write better but run out of free quota quickly.
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FAST_MODEL=gemini-3.1-flash-lite
